OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=
ANTHROPIC_API_KEY=
# LLM provider selector: anthropic (default) | deepseek
LLM_PROVIDER=anthropic
# DeepSeek — used when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Optional overrides (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=          # From @BotFather
TELEGRAM_CHAT_ID=            # Your personal admin chat ID (for private alerts)
TELEGRAM_WEBHOOK_SECRET=     # Any random string — used to verify requests come from Telegram
ADMIN_API_KEY=               # Any random string — used to protect the /api/telegram/setup endpoint

# Signal Reconciliation (Scalp vs Mirror scoring)
# Minimum price movement (in pips) for a signal to be scored WIN/LOSS.
# Below this, the outcome is INCONCLUSIVE (noise, not confirmation).
# Default 0.3 pips.
SIGNAL_RECON_NOISE_THRESHOLD_PIPS=0.3
# Max reconciliation rows to resolve per worker sweep. Default 20.
SIGNAL_RECON_RESOLVE_BATCH=20

