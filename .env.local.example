OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=
ANTHROPIC_API_KEY=
# LLM provider selector: anthropic (default) | deepseek
LLM_PROVIDER=anthropic
# DeepSeek — used when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Optional overrides (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=          # From @BotFather
TELEGRAM_CHAT_ID=            # Your personal admin chat ID (for private alerts)
TELEGRAM_WEBHOOK_SECRET=     # Any random string — used to verify requests come from Telegram
ADMIN_API_KEY=               # Any random string — used to protect the /api/telegram/setup endpoint

# Signal Reconciliation (Scalp vs Mirror scoring)
# Minimum price movement (in pips) for a signal to be scored WIN/LOSS.
# Below this, the outcome is INCONCLUSIVE (noise, not confirmation).
# Default 0.3 pips.
SIGNAL_RECON_NOISE_THRESHOLD_PIPS=0.3
# Max reconciliation rows to resolve per worker sweep. Default 20.
SIGNAL_RECON_RESOLVE_BATCH=20


# Max reconciliation rows to resolve per worker sweep. Default 20.
SIGNAL_RECON_RESOLVE_BATCH=20

# ── Expectancy Engine (2026-09-02) ──────────────────────────────────────────
# Historical window for R-multiple sampling (closed trades + resolved
# predictions). Default 60 days.
EXPECTANCY_WINDOW_DAYS=60
# Sample-size confidence bands (counts): <20 = insufficient, 20-49 low,
# 50-99 moderate, 100+ strong. Configurable per band.
EXPECTANCY_SAMPLE_LOW=20
EXPECTANCY_SAMPLE_MODERATE=50
EXPECTANCY_SAMPLE_STRONG=100
# Minimum positive expectancy (in R) for a segment to be POSITIVE. Default 0.15.
EXPECTANCY_MIN_POSITIVE_R=0.15

# ── Safety Score (independent of signal strength) ───────────────────────────
# Component weights (must sum to ~1 across the 7 components).
# SAFETY_WEIGHT_SPREAD=0.20
# SAFETY_WEIGHT_TREND=0.15
# SAFETY_WEIGHT_SESSION=0.15
# SAFETY_WEIGHT_HTF=0.15
# SAFETY_WEIGHT_NEWS=0.10
# SAFETY_WEIGHT_STOP=0.10
# SAFETY_WEIGHT_EXPOSURE=0.15
# Authority gate thresholds.
# SAFETY_EXECUTE_MIN=60       # ≥ this → tradeable on safety alone
# SAFETY_HARD_BLOCK_AT=40     # < this → unsafe regardless of edge

# ── Qualified Setup Alerts ──────────────────────────────────────────────────
# A setup only alerts when the authority APPROVES it AND every bar clears:
#   expectancy ≥ QUALIFY_MIN_EXPECTANCY_R, safety ≥ QUALIFY_MIN_SAFETY,
#   signal confidence ≥ QUALIFY_MIN_CONFIDENCE.
QUALIFY_MIN_EXPECTANCY_R=0.2
QUALIFY_MIN_SAFETY=80
QUALIFY_MIN_CONFIDENCE=75
